{
  "name": "chrome-extension",
  "author": "Alex Schmitt",
  "version": "0.1.13",
  "description": "chrome extension - core settings",
  "type": "module",
  "scripts": {
    "clean:node_modules": "pnpx rimraf node_modules",
    "clean:turbo": "rimraf .turbo",
    "clean": "pnpm clean:turbo && pnpm clean:node_modules",
    "build": "vite build",
    "dev": "cross-env __DEV__=true vite build --mode development",
    "test": "pnpm vitest run",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier . --write --ignore-path ../.prettierignore",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.87",
    "@ai-sdk/azure": "^4.0.109",
    "@ai-sdk/cerebras": "^3.0.77",
    "@ai-sdk/deepseek": "^3.0.72",
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/groq": "^4.0.69",
    "@ai-sdk/openai": "^4.0.101",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@ai-sdk/xai": "^5.0.29",
    "@extension/i18n": "workspace:*",
    "@extension/shared": "workspace:*",
    "@extension/storage": "workspace:*",
    "ai": "^7.0.150",
    "jsonrepair": "^3.15.0",
    "posthog-js": "^1.438.20",
    "puppeteer-core": "^25.16.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "form-data": "^4.0.4"
  },
  "devDependencies": {
    "@extension/dev-utils": "workspace:*",
    "@extension/hmr": "workspace:*",
    "@extension/tsconfig": "workspace:*",
    "@extension/vite-config": "workspace:*",
    "@types/ws": "^8.18.2",
    "cross-env": "^10.1.0",
    "deepmerge": "^4.3.1",
    "vitest": "5.0.5"
  }
}
