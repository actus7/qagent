                "title": "Key",
                "type": "string",
              },
            },
            "required": [
              "key",
            ],
            "title": "Press",
            "type": "object",
          },
          "previous_page": {
            "description": "Scroll the document in the window or an element to the previous page. If no index is specified, scroll the whole document.",
            "nullable": true,
            "properties": {
              "index": {
                "description": "index of the element",
                "nullable": true,
                "title": "Index",
                "type": "integer",
