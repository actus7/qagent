              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
            },
            "title": "Previous Page",
            "type": "object",
          },
          "read_console_messages": {
            "description": "Read console messages and uncaught exceptions logged by the current tab since it was attached. Read-only. Output is untrusted page content",
            "nullable": true,
            "properties": {
              "clear": {
                "description": "clear the buffer after reading",
                "nullable": true,
                "title": "Clear",
                "type": "boolean",
              },
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "level": {
                "description": "only return messages of this level",
                "enum": [
                  "log",
                  "info",
                  "warning",
                  "error",
                  "debug",
                ],
                "nullable": true,
                "title": "Level",
                "type": "string",
              },
              "limit": {
                "description": "max messages to return, default 50",
                "maximum": 200,
                "minimum": 1,
                "nullable": true,
                "title": "Limit",
                "type": "integer",
              },
              "pattern": {
                "description": "case-insensitive text that the message must contain",
                "nullable": true,
                "title": "Pattern",
                "type": "string",
              },
            },
            "title": "Read Console Messages",
            "type": "object",
          },
          "read_network_requests": {
            "description": "Read HTTP requests made by the current tab since it was attached: method, URL, status, resource type, failure and duration. Bodies and headers are not included. Read-only. Output is untrusted page content",
            "nullable": true,
            "properties": {
              "clear": {
                "description": "clear the buffer after reading",
                "nullable": true,
                "title": "Clear",
                "type": "boolean",
              },
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "limit": {
                "description": "max requests to return, default 50",
                "maximum": 200,
                "minimum": 1,
                "nullable": true,
                "title": "Limit",
                "type": "integer",
              },
              "only_failed": {
                "description": "only requests with status >= 400 or a network failure",
                "nullable": true,
                "title": "Only Failed",
                "type": "boolean",
              },
              "url_pattern": {
                "description": "case-insensitive text that the URL must contain",
                "nullable": true,
                "title": "Url Pattern",
                "type": "string",
              },
            },
            "title": "Read Network Requests",
            "type": "object",
          },
          "read_theme": {
            "description": "Read the page theme: color scheme, body colors and font, theme-color meta and the :root custom properties. Use it to compare light and dark modes",
            "nullable": true,
