              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "tab_id": {
                "description": "id of the tab to switch to",
                "title": "Tab Id",
                "type": "integer",
              },
            },
            "required": [
              "tab_id",
            ],
            "title": "Switch Tab",
            "type": "object",
          },
          "todo_write": {
            "description": "Replace the task checklist with these items (send the full list each time). Status: pending, in_progress or done. The checklist is shown to the user and repeated in each step",
            "nullable": true,
            "properties": {
              "items": {
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "pending",
                        "in_progress",
                        "done",
                      ],
                      "title": "Status",
                      "type": "string",
                    },
                    "text": {
                      "description": "what this step does",
                      "maxLength": 200,
                      "minLength": 1,
                      "title": "Text",
                      "type": "string",
                    },
                  },
                  "required": [
                    "text",
                    "status",
                  ],
                  "type": "object",
                },
                "maxItems": 30,
                "minItems": 1,
                "title": "Items",
                "type": "array",
              },
            },
            "required": [
              "items",
            ],
            "title": "Todo Write",
            "type": "object",
          },
          "type": {
            "description": "Type text in an element without clearing existing content first",
            "nullable": true,
            "properties": {
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "selector": {
                "description": "selector to target an element. Prefer refs from snapshot (ex: @e12). CSS selectors are also supported.",
                "title": "Selector",
                "type": "string",
              },
              "target": {
                "description": "readable target {text, role, nth}, used when no ref fits",
                "properties": {
                  "nth": {
                    "description": "0-based index when several elements match, default 0",
                    "minimum": 0,
                    "title": "Nth",
                    "type": "integer",
                  },
                  "role": {
                    "description": "ARIA role or tag, e.g. button, link, textbox",
                    "title": "Role",
                    "type": "string",
                  },
                  "selector": {
                    "description": "CSS selector to search within (default: interactive elements)",
                    "title": "Selector",
                    "type": "string",
                  },
                  "text": {
                    "description": "visible text the element contains, case-insensitive",
                    "title": "Text",
                    "type": "string",
                  },
                },
                "title": "Target",
                "type": "object",
              },
              "text": {
                "description": "text to type",
                "title": "Text",
                "type": "string",
              },
            },
            "required": [
              "text",
            ],
            "title": "Type",
            "type": "object",
          },
          "upload_file": {
            "description": "Attach a file to a file input (<input type=file>) by index. Either provide the file name and its full text content, set "attachment" to the exact name of a file the user attached to this task (use this for binary files such as PDFs or images), or set "path" to a local file such as a downloaded one; use it for forms that require an upload",
            "nullable": true,
            "properties": {
              "attachment": {
                "description": "exact name of a file attached by the user for this task; the bytes are uploaded unchanged",
                "nullable": true,
                "title": "Attachment",
                "type": "string",
              },
              "content": {
                "description": "full text content of the file (omit when using attachment)",
                "nullable": true,
                "title": "Content",
                "type": "string",
              },
              "file_name": {
                "description": "file name including extension, e.g. report.csv",
                "title": "File Name",
                "type": "string",
              },
              "index": {
                "description": "index of the file input element",
                "title": "Index",
                "type": "integer",
              },
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "mime_type": {
                "description": "MIME type, e.g. text/csv; defaults to text/plain",
                "nullable": true,
                "title": "Mime Type",
                "type": "string",
              },
              "path": {
                "description": "local file path, e.g. the path a download reports in list_downloads; the file is read by the browser",
                "nullable": true,
                "title": "Path",
                "type": "string",
              },
            },
            "required": [
              "index",
              "file_name",
            ],
            "title": "Upload File",
            "type": "object",
          },
          "wait": {
            "description": "Wait for x seconds default 3, do NOT use this action unless user asks to wait explicitly",
            "nullable": true,
            "properties": {
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "seconds": {
                "default": 3,
                "description": "amount of seconds",
                "title": "Seconds",
                "type": "integer",
              },
            },
            "title": "Wait",
            "type": "object",
          },
          "wait_for_element": {
            "description": "Wait until a target reaches a state: attached, visible, hidden or detached. Prefer it over a fixed wait action",
            "nullable": true,
            "properties": {
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "selector": {
                "description": "selector to target an element. Prefer refs from snapshot (ex: @e12). CSS selectors are also supported.",
                "title": "Selector",
                "type": "string",
              },
              "state": {
                "default": "visible",
                "description": "state to wait for",
                "enum": [
                  "attached",
                  "visible",
                  "hidden",
                  "detached",
                ],
                "title": "State",
                "type": "string",
              },
              "target": {
                "description": "readable target {text, role, nth}, used when no ref fits",
                "properties": {
                  "nth": {
                    "description": "0-based index when several elements match, default 0",
                    "minimum": 0,
                    "title": "Nth",
                    "type": "integer",
                  },
                  "role": {
                    "description": "ARIA role or tag, e.g. button, link, textbox",
                    "title": "Role",
                    "type": "string",
                  },
                  "selector": {
                    "description": "CSS selector to search within (default: interactive elements)",
                    "title": "Selector",
                    "type": "string",
                  },
                  "text": {
                    "description": "visible text the element contains, case-insensitive",
                    "title": "Text",
                    "type": "string",
                  },
                },
                "title": "Target",
                "type": "object",
              },
              "timeout_ms": {
                "default": 5000,
                "description": "give up after this many ms",
                "exclusiveMinimum": 0,
                "maximum": 30000,
                "title": "Timeout Ms",
                "type": "integer",
              },
            },
            "title": "Wait For Element",
            "type": "object",
          },
          "web_fetch": {
            "description": "Fetch a URL over HTTP without opening a tab and return its content (truncated). Use it for static pages and APIs; use the browser actions for pages that need JavaScript or interaction",
            "nullable": true,
            "properties": {
              "format": {
                "default": "text",
                "description": "text strips HTML tags; json pretty-prints JSON",
                "enum": [
                  "text",
                  "html",
                  "json",
                ],
                "title": "Format",
                "type": "string",
              },
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "maxLength": {
                "default": 20000,
                "description": "max characters returned",
                "maximum": 100000,
                "minimum": 100,
                "title": "Max Length",
                "type": "integer",
              },
              "url": {
                "description": "absolute http(s) URL",
                "format": "uri",
                "maxLength": 2000,
                "title": "Url",
                "type": "string",
              },
            },
            "required": [
              "url",
            ],
            "title": "Web Fetch",
            "type": "object",
          },
        },
        "type": "object",
      },
      "title": "Action",
      "type": "array",
    },
    "current_state": {
      "description": "Current state of the agent",
      "properties": {
        "evaluation_previous_goal": {
          "title": "Evaluation Previous Goal",
          "type": "string",
        },
        "memory": {
          "title": "Memory",
          "type": "string",
        },
        "next_goal": {
          "title": "Next Goal",
          "type": "string",
        },
      },
      "required": [
        "evaluation_previous_goal",
        "memory",
        "next_goal",
      ],
      "title": "Current State",
      "type": "object",
    },
  },
  "required": [
    "current_state",
    "action",
  ],
  "title": "NavigatorAgentOutput",
  "type": "object",
}
`;
