              },
            },
            "title": "Solve Captcha",
            "type": "object",
          },
          "start_monitor": {
            "description": "Watch an element (CSS selector) on the current page for a change, without polling. Returns a monitor id. The monitor ends at the first change, or after timeout_minutes, or when the page navigates",
            "nullable": true,
            "properties": {
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "selector": {
                "description": "CSS selector of the element to watch",
                "maxLength": 300,
                "minLength": 1,
                "title": "Selector",
                "type": "string",
              },
              "timeout_minutes": {
                "default": 30,
                "description": "end the watch after this many minutes",
                "maximum": 240,
                "minimum": 1,
                "title": "Timeout Minutes",
                "type": "integer",
              },
            },
            "required": [
              "selector",
            ],
            "title": "Start Monitor",
            "type": "object",
          },
          "stop_monitor": {
            "description": "Stop a monitor that is still watching",
            "nullable": true,
            "properties": {
              "id": {
                "description": "monitor id from start_monitor",
                "pattern": "^mon-[a-z0-9]{6}$",
                "title": "Id",
