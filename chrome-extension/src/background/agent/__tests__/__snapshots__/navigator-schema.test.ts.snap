              },
            },
            "title": "Snapshot",
            "type": "object",
          },
          "solve_captcha": {
            "description": "Tick a captcha checkbox and answer image challenges with the vision model, up to 10 rounds. Reports whether the captcha was solved. Use request_user_takeover when it is not",
            "nullable": true,
