exports[`navigator model contract > keeps the action prompts stable 1`] = `
[
  "Complete task:
{done: {'text': {'type': 'undefined', 'required': true}, 'success': {'type': 'undefined', 'required': true}}}",
  "Search the query in Google in the current tab, the query should be a search query like humans search in Google, concrete and not vague or super long. More the single most important items.:
{search_google: {'intent': {'type': 'purpose of this action', 'optional': true}, 'query': {'type': 'undefined', 'required': true}}}",
  "Navigate to URL in the current tab:
{open: {'intent': {'type': 'purpose of this action', 'optional': true}, 'url': {'type': 'undefined', 'required': true}}}",
  "Navigate to URL in the current tab:
{go_to_url: {'intent': {'type': 'purpose of this action', 'optional': true}, 'url': {'type': 'undefined', 'required': true}}}",
  "Go back to the previous page:
{back: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Go back to the previous page:
{go_back: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Go forward to the next page in history:
{forward: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Reload current page:
{reload: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Wait for x seconds default 3, do NOT use this action unless user asks to wait explicitly:
{wait: {'intent': {'type': 'purpose of this action', 'optional': true}, 'seconds': {'type': 'amount of seconds', 'optional': true}}}",
  "Click element by selector or readable target:
{click: {'intent': {'type': 'purpose of this action', 'optional': true}, 'selector': {'type': 'undefined', 'optional': true}, 'target': {'type': 'undefined', 'optional': true}}}",
  "Click element by index:
{click_element: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the element', 'required': true}, 'xpath': {'type': 'xpath of the element', 'optional': true}}}",
  "Clear and fill text in an input element:
{fill: {'intent': {'type': 'purpose of this action', 'optional': true}, 'selector': {'type': 'undefined', 'optional': true}, 'target': {'type': 'undefined', 'optional': true}, 'text': {'type': 'text to fill', 'required': true}}}",
  "Type text in an element without clearing existing content first:
{type: {'intent': {'type': 'purpose of this action', 'optional': true}, 'selector': {'type': 'undefined', 'optional': true}, 'target': {'type': 'undefined', 'optional': true}, 'text': {'type': 'text to type', 'required': true}}}",
  "Input text into an interactive input element:
{input_text: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the element', 'required': true}, 'text': {'type': 'text to input', 'required': true}, 'xpath': {'type': 'xpath of the element', 'optional': true}}}",
  "Press keyboard keys like Enter, Tab, Backspace and combinations like Control+o or Control+Shift+T:
{press: {'intent': {'type': 'purpose of this action', 'optional': true}, 'key': {'type': 'key or shortcut to send', 'required': true}}}",
  "Scroll the page by direction and optional pixels:
{scroll: {'intent': {'type': 'purpose of this action', 'optional': true}, 'direction': {'type': 'scroll direction', 'required': true}, 'pixels': {'type': 'pixel amount to scroll', 'optional': true}}}",
  "Scroll the target element into view:
{scrollintoview: {'intent': {'type': 'purpose of this action', 'optional': true}, 'selector': {'type': 'selector to target an element. Prefer refs from snapshot (ex: @e12). CSS selectors are also supported.', 'required': true}}}",
  "Get element text by selector or target, or the whole page when neither is given. Long text comes in groups: when the reply has a cursor, pass it back to read on:
{get_text: {'intent': {'type': 'purpose of this action', 'optional': true}, 'selector': {'type': 'undefined', 'optional': true}, 'target': {'type': 'undefined', 'optional': true}, 'max_length': {'type': 'characters per group', 'optional': true}, 'cursor': {'type': 'cursor from the previous group; omit to read from the top', 'optional': true}}}",
  "Get current page title:
{get_title: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Get current page URL:
{get_url: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Get current interactive elements snapshot with refs:
{snapshot: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Switch to tab by tab id:
{switch_tab: {'intent': {'type': 'purpose of this action', 'optional': true}, 'tab_id': {'type': 'id of the tab to switch to', 'required': true}}}",
  "Open URL in new tab:
{open_tab: {'intent': {'type': 'purpose of this action', 'optional': true}, 'url': {'type': 'url to open', 'required': true}}}",
  "Close tab by tab id:
{close_tab: {'intent': {'type': 'purpose of this action', 'optional': true}, 'tab_id': {'type': 'id of the tab', 'required': true}}}",
  "Cache what you have found so far from the current page for future use:
{cache_content: {'intent': {'type': 'purpose of this action', 'optional': true}, 'content': {'type': 'content to cache', 'optional': true}}}",
  "Scrolls to a particular vertical percentage of the document or an element. If no index of element is specified, scroll the whole document.:
{scroll_to_percent: {'intent': {'type': 'purpose of this action', 'optional': true}, 'yPercent': {'type': 'percentage to scroll to - min 0, max 100; 0 is top, 100 is bottom', 'required': true}, 'index': {'type': 'index of the element', 'optional': true}}}",
  "Scroll the document in the window or an element to the top:
{scroll_to_top: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the element', 'optional': true}}}",
  "Scroll the document in the window or an element to the bottom:
{scroll_to_bottom: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the element', 'optional': true}}}",
  "Scroll the document in the window or an element to the previous page. If no index is specified, scroll the whole document.:
{previous_page: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the element', 'optional': true}}}",
  "Scroll the document in the window or an element to the next page. If no index is specified, scroll the whole document.:
{next_page: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the element', 'optional': true}}}",
  "If you dont find something which you want to interact with in current viewport, try to scroll to it:
{scroll_to_text: {'intent': {'type': 'purpose of this action', 'optional': true}, 'text': {'type': 'text to scroll to', 'required': true}, 'nth': {'type': 'which occurrence of the text to scroll to (1-indexed, default: 1)', 'optional': true}}}",
  "Send strings of special keys like Backspace, Insert, PageDown, Delete, Enter. Shortcuts such as \`Control+o\`, \`Control+Shift+T\` are supported as well. This gets used in keyboard press. Be aware of different operating systems and their shortcuts:
{send_keys: {'intent': {'type': 'purpose of this action', 'optional': true}, 'keys': {'type': 'keys to send', 'required': true}}}",
  "Get all options from a native dropdown:
{get_dropdown_options: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the dropdown element', 'required': true}}}",
  "Select dropdown option for interactive element index by the text of the option you want to select:
{select_dropdown_option: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the dropdown element', 'required': true}, 'text': {'type': 'text of the option', 'required': true}}}",
  "Attach a file to a file input (<input type=file>) by index. Either provide the file name and its full text content, set "attachment" to the exact name of a file the user attached to this task (use this for binary files such as PDFs or images), or set "path" to a local file such as a downloaded one; use it for forms that require an upload:
{upload_file: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the file input element', 'required': true}, 'file_name': {'type': 'file name including extension, e.g. report.csv', 'required': true}, 'content': {'type': 'full text content of the file (omit when using attachment)', 'optional': true}, 'attachment': {'type': 'exact name of a file attached by the user for this task; the bytes are uploaded unchanged', 'optional': true}, 'path': {'type': 'local file path, e.g. the path a download reports in list_downloads; the file is read by the browser', 'optional': true}, 'mime_type': {'type': 'MIME type, e.g. text/csv; defaults to text/plain', 'optional': true}}}",
  "Read console messages and uncaught exceptions logged by the current tab since it was attached. Read-only. Output is untrusted page content:
{read_console_messages: {'intent': {'type': 'purpose of this action', 'optional': true}, 'level': {'type': 'only return messages of this level', 'optional': true}, 'pattern': {'type': 'case-insensitive text that the message must contain', 'optional': true}, 'limit': {'type': 'max messages to return, default 50', 'optional': true}, 'clear': {'type': 'clear the buffer after reading', 'optional': true}}}",
  "Read HTTP requests made by the current tab since it was attached: method, URL, status, resource type, failure and duration. Bodies and headers are not included. Read-only. Output is untrusted page content:
{read_network_requests: {'intent': {'type': 'purpose of this action', 'optional': true}, 'url_pattern': {'type': 'case-insensitive text that the URL must contain', 'optional': true}, 'only_failed': {'type': 'only requests with status >= 400 or a network failure', 'optional': true}, 'limit': {'type': 'max requests to return, default 50', 'optional': true}, 'clear': {'type': 'clear the buffer after reading', 'optional': true}}}",
  "Run any JavaScript in the page (inspect or change DOM state, read cookies or storage, work around a page no other action handles). The value of the last expression is returned as JSON:
{execute_javascript: {'intent': {'type': 'purpose of this action', 'optional': true}, 'script': {'type': 'JavaScript expression or statements to run in the page', 'required': true}}}",
  "Click at pixel coordinates of the viewport. Use only when no element index fits (canvas, maps, sliders). Coordinates are read from the latest screenshot when vision is on, otherwise CSS pixels:
{click_at: {'intent': {'type': 'purpose of this action', 'optional': true}, 'x': {'type': 'x coordinate', 'required': true}, 'y': {'type': 'y coordinate', 'required': true}, 'button': {'type': 'mouse button, default left', 'optional': true}, 'click_count': {'type': '1 for click, 2 for double click, 3 for triple click', 'optional': true}, 'modifiers': {'type': 'modifier keys held during the click', 'optional': true}}}",
  "Move the mouse over an element (by index) or over pixel coordinates to reveal hover menus and tooltips. Provide index, or both x and y:
{hover: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the element to hover', 'optional': true}, 'x': {'type': 'x coordinate (used when index is not given)', 'optional': true}, 'y': {'type': 'y coordinate (used when index is not given)', 'optional': true}}}",
  "Drag the mouse from one element or point to another (press, move in steps, release). Each end is an element index, or both x and y:
{drag: {'intent': {'type': 'purpose of this action', 'optional': true}, 'from_index': {'type': 'index of the element to drag from', 'optional': true}, 'from_x': {'type': 'x coordinate to drag from', 'optional': true}, 'from_y': {'type': 'y coordinate to drag from', 'optional': true}, 'to_index': {'type': 'index of the element to drag to', 'optional': true}, 'to_x': {'type': 'x coordinate to drag to', 'optional': true}, 'to_y': {'type': 'y coordinate to drag to', 'optional': true}, 'steps': {'type': 'mouse move steps, default 10', 'optional': true}}}",
  "Structural summary of the page: URL, title, landmarks, headings and the links, buttons, fields and forms with their ARIA state. Lists up to max_per_kind items per kind and reports the true totals. Use it to orient before snapshot:
{page_info: {'intent': {'type': 'purpose of this action', 'optional': true}, 'max_per_kind': {'type': 'items listed per kind', 'optional': true}, 'geometry': {'type': 'add bounding boxes to each item', 'optional': true}}}",
  "Find progress signals on the page: progress bars, percent text, spinners and busy regions. Use it to decide whether to wait for a job or ask the user:
{find_progress: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Wait until a target reaches a state: attached, visible, hidden or detached. Prefer it over a fixed wait action:
{wait_for_element: {'intent': {'type': 'purpose of this action', 'optional': true}, 'selector': {'type': 'undefined', 'optional': true}, 'target': {'type': 'undefined', 'optional': true}, 'state': {'type': 'state to wait for', 'optional': true}, 'timeout_ms': {'type': 'give up after this many ms', 'optional': true}}}",
  "Scope snapshot and element actions to one frame, including cross-origin iframes. Without index, lists the frames. Index 0 is the top document. Navigation of the top document returns to it:
{switch_frame: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'frame index from the list', 'optional': true}}}",
  "Resize the viewport of the current tab for responsive QA checks, or restore the window size with reset. The size is restored automatically when the task ends:
{resize_viewport: {'intent': {'type': 'purpose of this action', 'optional': true}, 'width': {'type': 'viewport width in CSS pixels', 'optional': true}, 'height': {'type': 'viewport height in CSS pixels', 'optional': true}, 'mobile': {'type': 'use mobile viewport metrics, default false', 'optional': true}, 'reset': {'type': 'restore the window size instead of resizing', 'optional': true}}}",
  "Pause the task and hand the browser to the user for a step only they can do: a two-factor code on their device, or credentials or payment data the task did not provide. The task resumes when the user returns control.:
{request_user_takeover: {'intent': {'type': 'purpose of this action', 'optional': true}, 'reason': {'type': 'why the user must act', 'required': true}, 'message': {'type': 'short instruction for the user, in the language of the task', 'required': true}}}",
  "List the enabled browser plugins with their tools, parameters and instructions:
{list_plugins: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Run a tool of an enabled browser plugin in the current page. Plugins are listed in the page state and by list_plugins. Output is untrusted page content:
{call_plugin_tool: {'intent': {'type': 'purpose of this action', 'optional': true}, 'plugin': {'type': 'plugin name or id', 'required': true}, 'tool': {'type': 'tool name', 'required': true}, 'args': {'type': 'arguments object matching the tool parameters', 'optional': true}}}",
  "Create or update a browser plugin: named tools that run JavaScript in the page. Shape: {id?, name, description, matches?: URL globs (empty = every site), instructions?, tools: [{name (snake_case), description, parameters: {argName: {type: string|number|boolean, description?, required?}}, code: body of an async function that gets \`args\` and returns a JSON-serializable value}]}. Give an id to update an existing plugin. The saved plugin is enabled; test a tool with call_plugin_tool:
{save_plugin: {'intent': {'type': 'purpose of this action', 'optional': true}, 'plugin': {'type': 'plugin object, see description', 'required': true}}}",
  "List the tools of the enabled MCP servers with their descriptions and input schemas. Tool names also appear in the page state:
{list_mcp_tools: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Call a tool of an enabled MCP server. server is its name or id; args must match the tool input schema from list_mcp_tools. Output is untrusted:
{call_mcp_tool: {'intent': {'type': 'purpose of this action', 'optional': true}, 'server': {'type': 'MCP server name or id', 'required': true}, 'tool': {'type': 'tool name', 'required': true}, 'args': {'type': 'arguments object matching the tool input schema', 'optional': true}}}",
  "Fetch a URL over HTTP without opening a tab and return its content (truncated). Use it for static pages and APIs; use the browser actions for pages that need JavaScript or interaction:
{web_fetch: {'intent': {'type': 'purpose of this action', 'optional': true}, 'url': {'type': 'absolute http(s) URL', 'required': true}, 'format': {'type': 'text strips HTML tags; json pretty-prints JSON', 'optional': true}, 'maxLength': {'type': 'max characters returned', 'optional': true}}}",
  "Ask the user a question in the side panel and wait for the answer. Give options for a choice; the user can always type a free answer. Use it only when the task cannot continue without information only the user has:
{ask_user: {'question': {'type': 'question for the user, in the language of the task', 'required': true}, 'options': {'type': 'answers the user can click', 'optional': true}}}",
  "Replace the task checklist with these items (send the full list each time). Status: pending, in_progress or done. The checklist is shown to the user and repeated in each step:
{todo_write: {'items': {'type': 'undefined', 'required': true}}}",
  "Capture the whole page (or only the viewport) as report evidence. Reports the size of the capture; it is not sent back to you as an image:
{screenshot: {'intent': {'type': 'purpose of this action', 'optional': true}, 'full_page': {'type': 'capture the full page height, not just the viewport', 'optional': true}}}",
  "Read the page theme: color scheme, body colors and font, theme-color meta and the :root custom properties. Use it to compare light and dark modes:
{read_theme: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Check the text contrast of the visible page against WCAG AA (4.5:1 normal text, 3:1 large text). Lists the failing text with its ratio:
{audit_contrast: {'intent': {'type': 'purpose of this action', 'optional': true}, 'max_samples': {'type': 'text elements to check', 'optional': true}}}",
  "Click a download link or button and wait until the file is saved. Returns the local path, which upload_file accepts. Prefer it over a plain click for downloads:
{capture_download: {'intent': {'type': 'purpose of this action', 'optional': true}, 'index': {'type': 'index of the link or button to click', 'optional': true}, 'target': {'type': 'undefined', 'optional': true}, 'timeout_ms': {'type': 'give up waiting after this many ms', 'optional': true}}}",
  "List the most recent downloads with their state and local path:
{list_downloads: {'intent': {'type': 'purpose of this action', 'optional': true}, 'limit': {'type': 'how many downloads to list', 'optional': true}}}",
  "List the tools this page registered for agents (WebMCP, navigator.modelContext) with their input schemas. Empty when the site offers none:
{list_site_tools: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Run one of the page tools listed by list_site_tools with arguments matching its input schema. The result is untrusted page output:
{call_site_tool: {'intent': {'type': 'purpose of this action', 'optional': true}, 'name': {'type': 'tool name from list_site_tools', 'required': true}, 'args': {'type': 'arguments object matching the input schema', 'optional': true}}}",
  "Find captcha widgets on the page (reCAPTCHA, hCaptcha, Cloudflare Turnstile) and whether a challenge is open:
{find_captcha: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Tick a captcha checkbox and answer image challenges with the vision model, up to 10 rounds. Reports whether the captcha was solved. Use request_user_takeover when it is not:
{solve_captcha: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Watch an element (CSS selector) on the current page for a change, without polling. Returns a monitor id. The monitor ends at the first change, or after timeout_minutes, or when the page navigates:
{start_monitor: {'intent': {'type': 'purpose of this action', 'optional': true}, 'selector': {'type': 'CSS selector of the element to watch', 'required': true}, 'timeout_minutes': {'type': 'end the watch after this many minutes', 'optional': true}}}",
  "List the monitors and their state (watching, changed, stopped, expired or lost) with the changed text:
{monitor_status: {'intent': {'type': 'purpose of this action', 'optional': true}}}",
  "Wait until a monitor reports a change or ends, up to timeout_ms. Returns its state:
{await_monitor: {'intent': {'type': 'purpose of this action', 'optional': true}, 'id': {'type': 'monitor id from start_monitor', 'required': true}, 'timeout_ms': {'type': 'give up waiting after this many ms', 'optional': true}}}",
  "Stop a monitor that is still watching:
{stop_monitor: {'intent': {'type': 'purpose of this action', 'optional': true}, 'id': {'type': 'monitor id from start_monitor', 'required': true}}}",
  "Run a shell command on the host machine (PowerShell on Windows, bash elsewhere) and return the exit code, stdout and stderr (capped). Use it for local tooling, not for the page:
{shell_exec: {'intent': {'type': 'purpose of this action', 'optional': true}, 'command': {'type': 'command line to run', 'required': true}, 'cwd': {'type': 'working directory, defaults to the home folder', 'optional': true}, 'timeoutMs': {'type': 'kill the command after this many ms', 'optional': true}}}",
  "Read a text file on the host machine, a window of lines (capped):
{fs_read: {'intent': {'type': 'purpose of this action', 'optional': true}, 'path': {'type': 'file path, absolute or relative to the daemon folder', 'required': true}, 'offset': {'type': 'first line to return, 0-based', 'optional': true}, 'limit': {'type': 'number of lines to return', 'optional': true}}}",
  "Write a text file on the host machine, creating parent folders and replacing the file:
{fs_write: {'intent': {'type': 'purpose of this action', 'optional': true}, 'path': {'type': 'file path, absolute or relative to the daemon folder', 'required': true}, 'content': {'type': 'full file content', 'required': true}}}",
  "List the entries of a folder on the host machine (names and types, capped):
{fs_list: {'intent': {'type': 'purpose of this action', 'optional': true}, 'path': {'type': 'folder path', 'required': true}}}",
  "Search text files under a folder on the host machine for a pattern (regex if it compiles, else literal, case-insensitive). Skips node_modules and .git:
{fs_search: {'intent': {'type': 'purpose of this action', 'optional': true}, 'path': {'type': 'folder to search', 'required': true}, 'pattern': {'type': 'text or regex to find', 'required': true}, 'maxResults': {'type': 'stop after this many matches', 'optional': true}}}",
]
`;

exports[`navigator model contract > keeps the structured-output JSON schema stable 1`] = `
{
  "properties": {
    "action": {
      "items": {
        "properties": {
          "ask_user": {
            "description": "Ask the user a question in the side panel and wait for the answer. Give options for a choice; the user can always type a free answer. Use it only when the task cannot continue without information only the user has",
            "nullable": true,
            "properties": {
              "options": {
                "description": "answers the user can click",
                "items": {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string",
                },
                "maxItems": 8,
                "title": "Options",
                "type": "array",
              },
              "question": {
                "description": "question for the user, in the language of the task",
                "maxLength": 500,
                "minLength": 1,
                "title": "Question",
                "type": "string",
              },
            },
            "required": [
              "question",
            ],
            "title": "Ask User",
            "type": "object",
          },
          "audit_contrast": {
            "description": "Check the text contrast of the visible page against WCAG AA (4.5:1 normal text, 3:1 large text). Lists the failing text with its ratio",
            "nullable": true,
            "properties": {
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "max_samples": {
                "default": 300,
                "description": "text elements to check",
                "maximum": 1000,
                "minimum": 10,
                "title": "Max Samples",
                "type": "integer",
              },
            },
            "title": "Audit Contrast",
            "type": "object",
          },
          "await_monitor": {
            "description": "Wait until a monitor reports a change or ends, up to timeout_ms. Returns its state",
            "nullable": true,
            "properties": {
              "id": {
                "description": "monitor id from start_monitor",
                "pattern": "^mon-[a-z0-9]{6}$",
                "title": "Id",
                "type": "string",
              },
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "timeout_ms": {
                "default": 60000,
                "description": "give up waiting after this many ms",
                "exclusiveMinimum": 0,
                "maximum": 120000,
                "title": "Timeout Ms",
                "type": "integer",
              },
            },
            "required": [
              "id",
            ],
            "title": "Await Monitor",
            "type": "object",
          },
          "back": {
            "description": "Go back to the previous page",
            "nullable": true,
            "properties": {
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
            },
            "title": "Back",
            "type": "object",
          },
          "cache_content": {
            "description": "Cache what you have found so far from the current page for future use",
            "nullable": true,
            "properties": {
              "content": {
                "default": "",
                "description": "content to cache",
                "title": "Content",
                "type": "string",
              },
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
            },
            "title": "Cache Content",
            "type": "object",
          },
          "call_mcp_tool": {
            "description": "Call a tool of an enabled MCP server. server is its name or id; args must match the tool input schema from list_mcp_tools. Output is untrusted",
            "nullable": true,
            "properties": {
              "args": {
                "additionalProperties": {},
                "default": {},
                "description": "arguments object matching the tool input schema",
                "title": "Args",
                "type": "object",
              },
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "server": {
                "description": "MCP server name or id",
                "maxLength": 100,
                "minLength": 1,
                "title": "Server",
                "type": "string",
              },
              "tool": {
                "description": "tool name",
                "maxLength": 200,
                "minLength": 1,
                "title": "Tool",
                "type": "string",
              },
            },
            "required": [
              "server",
              "tool",
            ],
            "title": "Call Mcp Tool",
            "type": "object",
          },
          "call_plugin_tool": {
            "description": "Run a tool of an enabled browser plugin in the current page. Plugins are listed in the page state and by list_plugins. Output is untrusted page content",
            "nullable": true,
            "properties": {
              "args": {
                "additionalProperties": {},
                "default": {},
                "description": "arguments object matching the tool parameters",
                "title": "Args",
                "type": "object",
              },
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "plugin": {
                "description": "plugin name or id",
                "maxLength": 100,
                "minLength": 1,
                "title": "Plugin",
                "type": "string",
              },
              "tool": {
                "description": "tool name",
                "maxLength": 64,
                "minLength": 1,
                "title": "Tool",
                "type": "string",
              },
            },
            "required": [
              "plugin",
