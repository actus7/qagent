            "title": "Reload",
            "type": "object",
          },
          "request_user_takeover": {
            "description": "Pause the task and hand the browser to the user for a step only they can do: a two-factor code on their device, or credentials or payment data the task did not provide. The task resumes when the user returns control.",
            "nullable": true,
            "properties": {
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "message": {
                "description": "short instruction for the user, in the language of the task",
                "title": "Message",
                "type": "string",
              },
              "reason": {
                "description": "why the user must act",
                "enum": [
                  "authentication",
                  "captcha",
                  "two_factor",
                  "payment",
                  "user_requested",
                  "other",
                ],
                "title": "Reason",
                "type": "string",
              },
            },
            "required": [
              "reason",
              "message",
            ],
            "title": "Request User Takeover",
            "type": "object",
          },
          "resize_viewport": {
            "description": "Resize the viewport of the current tab for responsive QA checks, or restore the window size with reset. The size is restored automatically when the task ends",
            "nullable": true,
            "properties": {
              "height": {
                "description": "viewport height in CSS pixels",
                "maximum": 2160,
                "minimum": 240,
                "nullable": true,
                "title": "Height",
                "type": "integer",
              },
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "mobile": {
                "description": "use mobile viewport metrics, default false",
                "nullable": true,
                "title": "Mobile",
                "type": "boolean",
              },
              "reset": {
                "description": "restore the window size instead of resizing",
                "nullable": true,
                "title": "Reset",
                "type": "boolean",
              },
              "width": {
                "description": "viewport width in CSS pixels",
                "maximum": 3840,
                "minimum": 320,
                "nullable": true,
                "title": "Width",
                "type": "integer",
              },
            },
            "title": "Resize Viewport",
            "type": "object",
          },
          "save_plugin": {
            "description": "Create or update a browser plugin: named tools that run JavaScript in the page. Shape: {id?, name, description, matches?: URL globs (empty = every site), instructions?, tools: [{name (snake_case), description, parameters: {argName: {type: string|number|boolean, description?, required?}}, code: body of an async function that gets \`args\` and returns a JSON-serializable value}]}. Give an id to update an existing plugin. The saved plugin is enabled; test a tool with call_plugin_tool",
            "nullable": true,
            "properties": {
              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "plugin": {
                "additionalProperties": {},
                "description": "plugin object, see description",
                "title": "Plugin",
                "type": "object",
              },
            },
            "required": [
              "plugin",
            ],
            "title": "Save Plugin",
            "type": "object",
          },
          "screenshot": {
            "description": "Capture the whole page (or only the viewport) as report evidence. Reports the size of the capture; it is not sent back to you as an image",
            "nullable": true,
            "properties": {
              "full_page": {
                "default": true,
                "description": "capture the full page height, not just the viewport",
                "title": "Full Page",
                "type": "boolean",
