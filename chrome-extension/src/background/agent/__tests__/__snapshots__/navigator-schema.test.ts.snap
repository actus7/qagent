                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
              "timeoutMs": {
                "default": 60000,
                "description": "kill the command after this many ms",
                "maximum": 600000,
                "minimum": 1000,
                "title": "Timeout Ms",
                "type": "integer",
              },
            },
            "required": [
              "command",
            ],
            "title": "Shell Exec",
            "type": "object",
          },
          "snapshot": {
