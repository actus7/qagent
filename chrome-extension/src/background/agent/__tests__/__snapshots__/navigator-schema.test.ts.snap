              "intent": {
                "default": "",
                "description": "purpose of this action",
                "title": "Intent",
                "type": "string",
              },
            },
            "title": "Switch Frame",
            "type": "object",
          },
          "switch_tab": {
            "description": "Switch to tab by tab id",
